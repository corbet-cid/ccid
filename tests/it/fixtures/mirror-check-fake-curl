#!/usr/bin/env bash
# A fake curl for the mirror-check tests: a forge that serves the release channel and the ccid packages.
# $FIX is the state directory, $TOOL_SOURCE the pointer URL the rendered script bakes in. Every request
# is appended to $FIX/calls.log as "METHOD URL" (and "AUTH header" when a request sent credentials).
set -u
out=''; fmt=''; url=''; fail=''
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -w) fmt="$2"; shift 2 ;;
    -H) case "$2" in Authorization:*|JOB-TOKEN:*|PRIVATE-TOKEN:*) echo "AUTH $2" >> "$FIX/calls.log" ;; esac; shift 2 ;;
    --max-time|--retry|--max-redirs) shift 2 ;;
    --fail) fail=1; shift ;;
    http*) url="$1"; shift ;;
    *) shift ;;
  esac
done
echo "GET $url" >> "$FIX/calls.log"
path="${TOOL_SOURCE#https://*/}"
status=200; location=''; file=''
case "$url" in
  "$TOOL_SOURCE")
    if [ -f "$FIX/no-redirect" ]; then :; else status=302; location="https://forge.example/$path"; fi ;;
  "https://forge.example/$path/raw/branch/main/channel.json")
    if [ -f "$FIX/channel.down" ]; then status=503; else file="$FIX/channel.json"; fi ;;
  "https://forge.example/api/packages/"*/generic/*/ccid-*)
    rev="${url%/ccid-*}"; rev="${rev##*/}"
    if [ -f "$FIX/packages/$rev" ]; then file="$FIX/packages/$rev"; else status=404; fi ;;
  *) status=404 ;;
esac
if [ -n "$file" ] && [ -n "$out" ] && [ "$out" != /dev/null ]; then cp "$file" "$out"; fi
if [ -n "$fmt" ]; then
  case "$fmt" in *redirect_url*) printf '%s' "$location" ;; *http_code*) printf '%s' "$status" ;; esac
fi
if [ -n "$fail" ] && [ "$status" -ge 400 ]; then exit 22; fi
exit 0
