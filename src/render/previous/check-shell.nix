# Generated by ccid render v1; edit .ci/ccid.toml instead.
# The one check-shell for every repository that opts in with [check_shell].
#
# One NATIVE C/C++ toolchain family (nix gcc 15.3), one nixpkgs pin, and the
# native libraries the build scripts discover through pkg-config. The
# toolchain, pkg-config, PKG_CONFIG_PATH, NIX_CFLAGS_COMPILE/NIX_LDFLAGS, the
# RUNPATH of everything linked here and LD_LIBRARY_PATH come from this one
# shell, together; nothing here mixes with /usr/lib, so a lane and CI build
# linked units with the same inputs.
#
# RUNPATH: a binary linked here runs without LD_LIBRARY_PATH (env -i, or a
# child started with a cleared environment). The nix ld wrapper would add an
# rpath for each library it links, but a Rust link here runs rustc's bundled
# rust-lld or a link driver's own Wild/mold, and neither passes through that
# wrapper. The cc wrapper hands NIX_LDFLAGS to whichever linker runs, so the
# shell names every runtime library directory there itself, and it adds no
# `-rpath $out/lib`: a shell has no $out, that store path never exists.
#
# Relinking: Cargo's freshness check never reads NIX_LDFLAGS, so a changed
# shell would leave every binary in an existing target directory linked
# against the previous shell. The same directory list therefore also reaches
# Cargo as host-target rustflags (`-rpath-link`: link-time search only, the
# RUNPATH stays as NIX_LDFLAGS writes it). Cargo fingerprints rustflags, so a
# changed library set relinks a persistent target. A job that sets RUSTFLAGS
# replaces target rustflags (Cargo's precedence) and loses this.
#
# gcc is the native driver on purpose (measured 2026-11-09): kache's
# host_crt probe asks the driver for `libc.a`; a clang driver answers with the
# HOST /usr/lib/libc.a on Arch and with nothing inside a NixOS runner (13 CRT
# objects here, 12 there), which splits every linked-unit key. The nix gcc
# wrapper searches only the nixpkgs store, so the placement is identical on
# both hosts. clang stays in the shell for what gcc cannot do:
#   - wasm32 C dependencies (ring, minicov, zstd, ...): gcc has no wasm32
#     target, and minicov hardcodes the `clang` command, so the unwrapped
#     compiler is on PATH and CC_wasm32_unknown_unknown names it;
#   - bindgen: libclang and LIBCLANG_PATH;
#   - barretenberg: libc++ (the crate links -lc++ itself).
{ pkgs ? import (builtins.fetchTarball {
  url = "https://github.com/NixOS/nixpkgs/archive/b7c2ada94fe99c15b0dbcf4d11fd7850b957a436.tar.gz";
  sha256 = "sha256-IItrdb7Puk05RqOBWZYFC5X6Wl1sJmCfh5MWVHw5iMM=";
}) {} }:
let
  inherit (pkgs) lib;
  nativeLibs = with pkgs; [ openssl xz zlib zstd sqlite libevent dbus ];
  runtimeLibs = nativeLibs ++ [ pkgs.llvmPackages.libclang.lib pkgs.llvmPackages.libcxx ];
  # Every directory a binary linked here may load a library from: the runtime
  # libraries above (libc++ and libc++abi included) and gcc's own runtime
  # (libstdc++, libgcc_s, libatomic). glibc is the binary's interpreter, which
  # finds its own libraries.
  rpathDirs = lib.unique (map (p: "${lib.getLib p}/lib") (runtimeLibs ++ [ pkgs.stdenv.cc.cc ]));
  python = pkgs.python3.withPackages (ps: [ ps.selenium ]);
  # Barretenberg is a per-repository content input: only a repository that
  # commits .ci/native-sdk.json gets the reviewed static artifact and its env.
  sdkFile = ./native-sdk.json;
  hasSdk = builtins.pathExists sdkFile;
  sdk = if hasSdk then builtins.fromJSON (builtins.readFile sdkFile) else null;
  bbSource = if hasSdk then pkgs.fetchurl {
    url = "https://github.com/AztecProtocol/barretenberg/releases/download/v${sdk.version}/barretenberg-static-amd64-linux.tar.gz";
    sha256 = sdk.sha256;
  } else null;
  bbLibrary = if hasSdk then pkgs.runCommand "barretenberg-static-${sdk.version}" {} ''
    mkdir -p "$out/lib"
    tar -xzf ${bbSource} -C "$out/lib" libbb-external.a
  '' else null;
  base = pkgs.mkShell {
    nativeBuildInputs = with pkgs; [
      pkg-config
      cmake
      mold
      wild
      llvmPackages.bintools
      llvmPackages.clang-unwrapped
    ];
    buildInputs = nativeLibs ++ [
      pkgs.llvmPackages.libclang.lib
      pkgs.llvmPackages.libcxx
      python
    ];
    LIBCLANG_PATH = "${pkgs.llvmPackages.libclang.lib}/lib";
    NIX_LDFLAGS = lib.concatMapStringsSep " " (dir: "-rpath ${dir}") rpathDirs;
    NIX_NO_SELF_RPATH = true;
    "CARGO_TARGET_${pkgs.stdenv.hostPlatform.rust.cargoEnvVarTarget}_RUSTFLAGS" =
      lib.concatMapStringsSep " " (dir: "-C link-arg=-Wl,-rpath-link,${dir}") rpathDirs;
    shellHook = ''
      export CC=gcc CXX=g++ AR=ar NM=nm RANLIB=ranlib
      export CC_wasm32_unknown_unknown=clang
      # Exact: the native libraries come from this shell, never from the host.
      export LD_LIBRARY_PATH="${lib.makeLibraryPath runtimeLibs}"
    '';
  };
in base // lib.optionalAttrs hasSdk {
  BB_LIB_DIR = "${bbLibrary}/lib";
  BB_NATIVE_RUSTFLAGS = "-C link-arg=-Wl,-rpath,${lib.makeLibraryPath [ pkgs.llvmPackages.libcxx ]}";
}
